{
  "name": "@lift/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Wire contract between the Lift Compass backend and delivery clients. zod is the only dependency — this package must load anywhere (node, Next.js, Hermes).",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "vectors"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
