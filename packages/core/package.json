{
  "name": "@lift/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "seed": "tsx src/warehouse/seed.ts",
    "ground-truth": "tsx src/warehouse/ground-truth.ts",
    "mcp:warehouse": "tsx src/mcp-warehouse/server.ts",
    "mcp:call": "tsx src/mcp-warehouse/call.ts",
    "demo": "tsx src/run/demo.ts",
    "opportunities": "tsx src/run/opportunities.ts",
    "fanout": "tsx src/run/fanout-demo.ts",
    "durable": "tsx src/run/durable-demo.ts",
    "activate": "tsx src/run/activate-demo.ts",
    "bandit": "tsx src/run/bandit-demo.ts",
    "board:data": "tsx src/run/board-data.ts",
    "stream:test": "tsx src/run/stream-test.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/guardrails dist/mcp-warehouse/semantic && cp src/guardrails/guardrails.yaml dist/guardrails/ && cp src/mcp-warehouse/semantic/metrics.yaml dist/mcp-warehouse/semantic/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@duckdb/node-api": "1.5.4-r.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "@lift/protocol": "workspace:^"
  },
  "devDependencies": {
    "@lift/sdk": "workspace:^"
  }
}
