# Copy to .env and fill in. Nothing here is required for the zero-configuration
# local demo: `pnpm ui:dev` runs with an empty file.
#
# Phases 0-1 (warehouse, MCP, stats verifier) do NOT need an API key - only the
# agent loop (Phase 2+) does.

ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Mode
# ---------------------------------------------------------------------------
# demo = deterministic fixtures, no spend, no API key needed (default).
# live = the real engine, which spends against ANTHROPIC_API_KEY.
LIFT_MODE=demo

# Serving anonymously is the local demo, and it is also what a production deploy
# looks like when its secrets fail to inject. So outside development the app
# refuses to serve without auth unless you opt in here on purpose. vercel.json
# sets this for the public demo; leave it unset for any real deployment.
LIFT_PUBLIC_DEMO=

# ---------------------------------------------------------------------------
# Persistence + identity
# ---------------------------------------------------------------------------
# Leave all three empty for the local file-backed demo repository. Set all three
# together for Supabase-backed workspaces - getRequestContext rejects a partial
# configuration rather than half-authenticating.
#
# NEXT_PUBLIC_* are inlined into the client bundle at BUILD time, so they must be
# present when `next build` runs, not only at run time. docker-compose.worker.yml
# passes them through as build args for exactly this reason.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute origin used to build share links. Defaults to the request origin.
APP_URL=http://localhost:3000

# Where the local demo repository keeps its state. Defaults to
# <repo>/runs/investigations-state.json. Must point somewhere writable - a
# read-only or ephemeral filesystem makes every mutation fail.
LIFT_INVESTIGATION_STATE_PATH=

# ---------------------------------------------------------------------------
# Durable worker
# ---------------------------------------------------------------------------
# The worker is deliberately a separate process in production (pnpm ui:worker).
# That topology REQUIRES DATABASE_URL: without it the web process and the worker
# each keep their own state file, so queued investigations are never picked up.
POSTGRES_POOL_SIZE=10
ASSISTANT_WORKER_CONCURRENCY=4
ENGINE_WORKER_CONCURRENCY=1
# How long the in-process pump waits before re-draining a queue that still holds
# backed-off retries.
WORKER_RETRY_SWEEP_MS=2500

# ---------------------------------------------------------------------------
# Tests
# ---------------------------------------------------------------------------
# The Postgres repository suite is skipped unless all three are set. It is the
# production persistence path, so set these before trusting a green test run:
#   TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# (that is the default `supabase start` connection string) plus a user and
# workspace that already exist in that database.
TEST_DATABASE_URL=
TEST_SUPABASE_USER_ID=
TEST_SUPABASE_WORKSPACE_ID=

# ---------------------------------------------------------------------------
# Engine
# ---------------------------------------------------------------------------
# Model tiering (override the defaults if you like)
MODEL_REASONING=claude-sonnet-4-6
MODEL_FANOUT=claude-haiku-4-5-20251001

# Explorer strategy and verifier fan-out width.
LIFT_EXPLORER=
VERIFY_CONCURRENCY=

# The stats verifier MCP is spawned over stdio by the engine (`uv run
# stats-server`), so there is no URL to configure.

# Warehouse
DUCKDB_PATH=packages/core/data/lift_compass.duckdb
SEED=42

# Query guardrails
QUERY_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# One-time importer for the pre-investigations runs/app-state.json
# ---------------------------------------------------------------------------
LEGACY_STATE_PATH=
LEGACY_OWNER_USER_ID=
LEGACY_OWNER_EMAIL=
LEGACY_WORKSPACE_ID=

# Expo device client - the API origin it polls for decision bundles.
EXPO_PUBLIC_LIFT_API=http://localhost:3000
