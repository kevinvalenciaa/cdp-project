# Copy to .env and fill in. The harness reads ANTHROPIC_API_KEY.
# Phases 0–1 (warehouse, MCP, stats verifier) do NOT need a key — only the agent loop (Phase 2+) does.

ANTHROPIC_API_KEY=

# Product persistence + identity. Omit these for the zero-configuration local
# demo repository; set all four for Supabase-backed workspaces.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=http://localhost:3000

# The durable worker is deliberately a separate process in production.
POSTGRES_POOL_SIZE=10
ASSISTANT_WORKER_CONCURRENCY=4
ENGINE_WORKER_CONCURRENCY=1

# One-time importer ownership for runs/app-state.json.
LEGACY_STATE_PATH=
LEGACY_OWNER_USER_ID=
LEGACY_OWNER_EMAIL=
LEGACY_WORKSPACE_ID=

# Model tiering (override the defaults if you like)
MODEL_REASONING=claude-sonnet-4-6
MODEL_FANOUT=claude-haiku-4-5-20251001

# Stats Verifier MCP (Python service) — Streamable HTTP endpoint
STATS_MCP_URL=http://127.0.0.1:8765/mcp

# Warehouse
DUCKDB_PATH=packages/core/data/lift_compass.duckdb
SEED=42

# Query guardrails
QUERY_TIMEOUT_MS=15000
