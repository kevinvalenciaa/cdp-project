# Copy to .env and fill in. The harness reads ANTHROPIC_API_KEY.
# Phases 0–1 (warehouse, MCP, stats verifier) do NOT need a key — only the agent loop (Phase 2+) does.

ANTHROPIC_API_KEY=

# Model tiering (override the defaults if you like)
MODEL_REASONING=claude-sonnet-4-6
MODEL_FANOUT=claude-haiku-4-5-20251001
MODEL_HARD=claude-opus-4-8

# Stats Verifier MCP (Python service) — Streamable HTTP endpoint
STATS_MCP_URL=http://127.0.0.1:8765/mcp

# Warehouse
DUCKDB_PATH=packages/core/data/lift_compass.duckdb
SEED=42

# Query guardrails
QUERY_TIMEOUT_MS=15000
